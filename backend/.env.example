# ローカル開発用。docker-compose.yml の DB 設定に合わせている
# 項目と初期値の一覧は docs/adr/0016-env-config-validation.md を参照
DATABASE_URL="postgresql://app:app@localhost:5432/self_introduce"

# 統合テスト用(npm run test:integration)。DB 名は _test で終わらせる
TEST_DATABASE_URL="postgresql://app:app@localhost:5432/self_introduce_test"

# 任意。未設定なら初期値を使う
# NODE_ENV=development
# HOST=127.0.0.1
# PORT=3000
# LOG_LEVEL=info
# STORAGE_DIR=.storage
# STORAGE_BASE_URL=http://localhost:3000/storage
